{% comment %}
  Ecomexperts Shopify Developer Test — Product Grid section
  Built from scratch (no Dawn section/component reused).

  Grid: 3x2 desktop (433x444 cards, 20px gap) / 2x3 mobile (169x186, 4px gap) — see Figma spec.
  Each card's "+" circle opens that product's popup (snippets/ecomexperts-product-popup.liquid).

  Special cart rule (requirement #8): when a variant with Color=Black AND
  Size=Medium is added to cart, "Soft Winter Jacket" is auto-added too.
  The jacket's variant ID is NEVER hardcoded — it's looked up here, by
  product title, from live store data, and handed to the JS as plain
  data. See assets/ecomexperts-test.js → addSoftWinterJacketIfNeeded().
{% endcomment %}

{{ 'ecomexperts-test.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ecomexperts-test.js' | asset_url }}" defer="defer"></script>

{%- assign jacket_product = null -%}
{%- paginate collections.all.products by 250 -%}
  {%- for product in collections.all.products -%}
    {%- if product.title == 'Soft Winter Jacket' -%}
      {%- assign jacket_product = product -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endpaginate -%}

<section class="ee-grid-section" id="EcomexpertsGrid-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="ee-grid-section__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="ee-grid" data-product-grid>
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        <div class="ee-grid__card" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="ee-grid__image-wrap"
            data-open-popup
            data-product-id="{{ product.id }}"
            aria-label="Quick view {{ product.title | escape }}"
          >
            {%- if product.featured_image != blank -%}
              <img
                class="ee-grid__image"
                src="{{ product.featured_image | image_url: width: 866 }}"
                srcset="{{ product.featured_image | image_url: width: 433 }} 433w, {{ product.featured_image | image_url: width: 866 }} 866w"
                sizes="(min-width: 750px) 433px, 169px"
                alt="{{ product.featured_image.alt | escape | default: product.title }}"
                loading="lazy"
                width="433"
                height="444"
              >
            {%- endif -%}
            <span class="ee-grid__circle" aria-hidden="true">
              <span class="ee-icon-plus"></span>
            </span>
          </button>
        </div>
        {%- render 'ecomexperts-product-popup', product: product, section_id: section.id -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} Dynamically-resolved Soft Winter Jacket data — no hardcoded variant ID {%- endcomment -%}
<script type="application/json" id="ee-jacket-data">
  {%- if jacket_product -%}
    {
      "found": true,
      "id": {{ jacket_product.id | json }},
      "title": {{ jacket_product.title | json }},
      "variants": [
        {%- for variant in jacket_product.variants -%}
          { "id": {{ variant.id | json }}, "available": {{ variant.available | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  {%- else -%}
    { "found": false }
  {%- endif -%}
</script>

{% schema %}
{
  "name": "Ecomexperts Product Grid",
  "tag": "section",
  "class": "ee-grid-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Ecomexperts Product Grid",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}
